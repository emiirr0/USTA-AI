# USTA·AI ortam ayarları — bu dosyayı ".env" adıyla kopyalayıp düzenleyin.
# .env dosyası .gitignore'dadır: API anahtarınız GitHub'a YÜKLENMEZ.

# Claude API anahtarı (https://platform.claude.com/settings/keys).
# Boş bırakılırsa USTA internetsiz çalışan "çevrimdışı uzman" ile çalışır.
ANTHROPIC_API_KEY=

# AI kaynağı: otomatik | claude | ollama | uzman
USTA_AI=otomatik

# İsteğe bağlı
# USTA_MODEL=claude-sonnet-5-5
# USTA_OLLAMA_MODEL=llama3.1
# USTA_PORT=8080
# GÖZCÜ·AI çalışma klasörü (fire verisi PANO'ya ve AI'ya akar):
# USTA_GOZCU=C:\Users\kullanici\Desktop\gozcu-ai
